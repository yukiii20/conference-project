# Optional — defaults to "/api" (proxied to the Node backend by vite.config.ts).
# VITE_API_URL=/api

# Dev server only (vite.config.ts): where /api and /files are proxied to. Defaults to
# http://localhost:4000. The Playwright stack sets it to http://localhost:4100.
# VITE_API_PROXY_TARGET=http://localhost:4000
