# Copy to .env and fill in real values. Never commit .env itself.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cms_app
DB_PASSWORD=
DB_NAME=conference_cms

# MySQL connection pool size. 20 by default - see load/README.md for why
# mysql2's own default of 10 queues badly under real concurrent traffic.
# Keep this comfortably under MySQL's own max_connections (150 by default) -
# and well under Aiven's free-plan 76 connection cap if DB_HOST points there.
DB_POOL_SIZE=20

# --- Database SSL (Aiven, etc.) ----------------------------------------
# Off by default — local MySQL doesn't need it. Aiven's MySQL REQUIRES SSL:
# set DB_SSL=true and paste the CA certificate text from the Aiven console
# into DB_SSL_CA (or point DB_SSL_CA_PATH at a file containing it instead).
# See docs/aiven-mysql-setup.md.
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_PATH=

# 32+ random bytes, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development

# Express 'trust proxy' setting — only set this when running behind a proxy
# (Nginx, Render, ...). On Render, set this to exactly "1" — Render adds one
# proxy hop in front of the app, and req.ip needs to see past exactly that
# one hop to find the real visitor IP (used by rate limits and the audit
# log). See docs/deploy-guide.md. Leave empty for local development.
TRUST_PROXY=

# --- Email -------------------------------------------------------------
# console: prints emails to the server log instead of sending them (default).
# smtp: sends for real via the SMTP_* settings below (all required then).
#   Render's FREE web services block outbound SMTP ports (25/465/587) — use
#   smtp only on a paid Render plan.
# brevo: sends over Brevo's HTTPS transactional email API (BREVO_API_KEY +
#   MAIL_FROM below) — works on Render's free plan too.
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Conference CMS <address>"
# Required when EMAIL_MODE=brevo — from the Brevo dashboard (SMTP & API ->
# API Keys). MAIL_FROM above must be a sender verified in Brevo.
BREVO_API_KEY=

# Base URL the frontend is served from — used to build links in emails
# (password reset, invitations, ...). Never hard-code localhost elsewhere.
APP_URL=http://localhost:5173

# Where uploaded files (logos, banners, photos, certificates) live. Defaults
# to server/storage, same as always. On Render, point this at the mounted
# persistent disk (e.g. /var/data/storage) — Render's normal filesystem is
# wiped on every deploy/restart, so files written anywhere else are lost.
STORAGE_DIR=
