# Copy to .env and fill in real values. Never commit .env itself.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cms_app
DB_PASSWORD=
DB_NAME=conference_cms

# MySQL connection pool size. 20 by default - see load/README.md for why
# mysql2's own default of 10 queues badly under real concurrent traffic.
# Keep this comfortably under MySQL's own max_connections (150 by default).
DB_POOL_SIZE=20

# 32+ random bytes, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development

# Express 'trust proxy' setting — only set this when running behind Nginx/a
# load balancer (see docs/deploy.md). Leave empty for local development.
TRUST_PROXY=

# --- Email -------------------------------------------------------------
# console: prints emails to the server log instead of sending them (default).
# smtp: sends for real via the SMTP_* settings below (all required then).
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Conference CMS <address>"

# Base URL the frontend is served from — used to build links in emails
# (password reset, invitations, ...). Never hard-code localhost elsewhere.
APP_URL=http://localhost:5173
